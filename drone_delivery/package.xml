<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drone_delivery</name>
  <version>0.0.0</version>
  <description>Drone delivery in Gazebo: a quadcopter that reads ArUco IDs, picks up boxes with a vacuum gripper, and drops them at target locations.</description>
  <maintainer email="sparab@umd.edu">Shantanu Parab</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>xacro</build_depend>

  <depend>gazebo_ros_pkgs</depend>
  <depend>robot_state_publisher</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>ros2_control</depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>drone_plugin</depend>
  <depend>gazebo_ros</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>rosbag2_cpp</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_kdl</depend>
  <depend>orocos_kdl_vendor</depend>
  <depend>cv_bridge</depend>
  <depend>gazebo_ros2_control</depend>
  <exec_depend>xacro</exec_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/.." />
    <!-- box_0..box_4 and landing_pad, referenced by the worlds as model://<name> -->
    <gazebo_ros gazebo_model_path="${prefix}/models" />

  </export>
</package>
