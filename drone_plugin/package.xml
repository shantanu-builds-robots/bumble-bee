<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drone_plugin</name>
  <version>0.1.0</version>
  <description>
    Gazebo Classic model plugin that makes the drone fly: converts per-rotor
    speeds into thrust and torque, publishes the drone pose, and implements a
    contact-based vacuum gripper for picking up delivery boxes. Also defines
    the MotorSpeed message.
  </description>
  <maintainer email="sparab@umd.edu">Shantanu Parab</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>gazebo_ros</depend>
  <depend>gazebo_dev</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- Lets Gazebo find libdrone.so from the URDF's <plugin filename="libdrone.so"> -->
    <gazebo_ros plugin_path="${prefix}/../../lib" />
  </export>
</package>
